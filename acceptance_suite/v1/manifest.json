    {
      "id": "warehouse_atomic",
      "workspace_dir": "warehouse_atomic/workspace",
      "task": "Finish the small warehouse dispatch planner. Its entry point is dispatch.plan_dispatch(stock, orders). Stock is a mapping of canonical uppercase SKU strings to nonnegative integer quantities. Orders arrive in priority order and have a unique order_id plus a nonempty lines list of {sku, quantity}; quantities are positive integers. You may assume all inputs satisfy those types.\n\nNormalize each requested SKU by stripping surrounding whitespace and uppercasing it, then combine duplicate SKU lines within that order. Process orders in their input order. Reserve an entire order only if every combined quantity is available. An unknown SKU has availability zero. If any SKU is short, reject the entire order without consuming any stock; include every shortage, not just the first. A later order must see only stock consumed by earlier successful orders. Do not mutate either input.\n\nReturn {remaining: <stock mapping>, orders: <result list>}. Keep every original stock SKU in remaining, including zero quantities, and never add unknown SKUs. Each result must contain order_id, status (reserved or rejected), items, and shortages. items is the normalized, combined request, represented as a SKU-sorted list of {sku, quantity}. shortages is a SKU-sorted list of {sku, requested, available}; it is empty for a reserved order. Preserve input order for the order results. The existing modules divide normalization, reservation, and orchestration; complete the behavior while keeping this public entry point and schema. Run python3 -m unittest discover -s tests -v. Public tests are immutable.",
      "immutable_files": [
        "README.md",
        "tests/__init__.py",
        "tests/test_dispatch.py"
      ],
      "oracle": {
        "module": "dispatch",
        "function": "plan_dispatch",
        "inputs": [
          [
            {
              "TEA": 7,
              "MUG": 3
            },
            [
              {
                "order_id": "a",
                "lines": [
                  {
                    "sku": " tea ",
                    "quantity": 2
                  },
                  {
                    "sku": "TEA",
                    "quantity": 1
                  },
                  {
                    "sku": "mug",
                    "quantity": 1
                  }
                ]
              },
              {
                "order_id": "b",
                "lines": [
                  {
                    "sku": "TEA",
                    "quantity": 5
                  },
                  {
                    "sku": "MUG",
                    "quantity": 1
                  }
                ]
              },
              {
                "order_id": "c",
                "lines": [
                  {
                    "sku": "tea",
                    "quantity": 4
                  },
                  {
                    "sku": " MUG ",
                    "quantity": 2
                  }
                ]
              }
            ]
          ],
          [
            {
              "A": 2,
              "B": 0
            },
            [
              {
                "order_id": "large",
                "lines": [
                  {
                    "sku": "Z",
                    "quantity": 1
                  },
                  {
                    "sku": "B",
                    "quantity": 1
                  },
                  {
                    "sku": "A",
                    "quantity": 3
                  }
                ]
              },
              {
                "order_id": "fits",
                "lines": [
                  {
                    "sku": "a",
                    "quantity": 2
                  }
                ]
              }
            ]
          ],
          [
            {
              "WIDGET": 5,
              "GADGET": 4
            },
            [
              {
                "order_id": "x",
                "lines": [
                  {
                    "sku": "widget",
                    "quantity": 2
                  },
                  {
                    "sku": " WIDGET",
                    "quantity": 3
                  }
                ]
              },
              {
                "order_id": "y",
                "lines": [
                  {
                    "sku": "GADGET",
                    "quantity": 2
                  },
                  {
                    "sku": "missing",
                    "quantity": 1
                  }
                ]
              },
              {
                "order_id": "z",
                "lines": [
                  {
                    "sku": "gadget",
                    "quantity": 4
                  }
                ]
              }
            ]
          ],
          [
            {},
            [
              {
                "order_id": "unknown",
                "lines": [
                  {
                    "sku": " ghost ",
                    "quantity": 2
                  },
                  {
                    "sku": "GHOST",
                    "quantity": 3
                  }
                ]
              }
            ]
          ],
          [
            {
              "ZERO": 0,
              "SPARE": 11
            },
            []
          ]
        ],
        "expected": [
          {
            "remaining": {
              "TEA": 0,
              "MUG": 0
            },
            "orders": [
              {
                "order_id": "a",
                "status": "reserved",
                "items": [
                  {
                    "sku": "MUG",
                    "quantity": 1
                  },
                  {
                    "sku": "TEA",
                    "quantity": 3
                  }
                ],
                "shortages": []
