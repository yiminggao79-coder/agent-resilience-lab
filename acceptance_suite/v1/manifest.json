                "items": [
                  {
                    "sku": "WIDGET",
                    "quantity": 5
                  }
                ],
                "shortages": []
              },
              {
                "order_id": "y",
                "status": "rejected",
                "items": [
                  {
                    "sku": "GADGET",
                    "quantity": 2
                  },
                  {
                    "sku": "MISSING",
                    "quantity": 1
                  }
                ],
                "shortages": [
                  {
                    "sku": "MISSING",
                    "requested": 1,
                    "available": 0
                  }
                ]
              },
              {
                "order_id": "z",
                "status": "reserved",
                "items": [
                  {
                    "sku": "GADGET",
                    "quantity": 4
                  }
                ],
                "shortages": []
              }
            ]
          },
          {
            "remaining": {},
            "orders": [
              {
                "order_id": "unknown",
                "status": "rejected",
                "items": [
                  {
                    "sku": "GHOST",
                    "quantity": 5
                  }
                ],
                "shortages": [
                  {
                    "sku": "GHOST",
                    "requested": 5,
                    "available": 0
                  }
                ]
              }
            ]
          },
          {
            "remaining": {
              "ZERO": 0,
              "SPARE": 11
            },
            "orders": []
          }
        ]
      }
