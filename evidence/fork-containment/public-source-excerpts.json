    {
      "path": "bsd/kern/proc_info.c",
      "blob_sha": "b33d15299447ba88be8c17d9c53795c912b519c6",
      "url": "https://github.com/apple-oss-distributions/xnu/blob/d8b80295118ef25ac3a784134bcf95cd8e88109f/bsd/kern/proc_info.c",
      "excerpts": [
        {
          "start_line": 3114,
          "end_line": 3122,
          "lines": [
            "proc_security_policy(proc_t targetp, __unused int callnum, __unused int flavor, boolean_t check_same_user)",
            "{",
            "#if CONFIG_MACF",
            "\tint error = 0;",
            "",
            "\tif ((error = mac_proc_check_proc_info(current_proc(), targetp, callnum, flavor))) {",
            "\t\treturn error;",
            "\t}",
            "#endif"
          ]
        },
        {
          "start_line": 3178,
          "end_line": 3255,
          "lines": [
            "proc_setcontrol(int pid, int flavor, uint64_t arg, user_addr_t buffer, uint32_t buffersize, __unused int32_t * retval)",
            "{",
            "\tstruct proc * pself = PROC_NULL;",
            "\tint error = 0;",
            "\tuint32_t pcontrol = (uint32_t)arg;",
            "\tstruct uthread *ut = NULL;",
            "\tchar name_buf[MAXTHREADNAMESIZE];",
            "",
            "\tpself = current_proc();",
            "\tif (pid != proc_getpid(pself)) {",
            "\t\treturn EINVAL;",
            "\t}",
            "",
            "\t/* Do we have permission to look into this? */",
            "\tif ((error = proc_security_policy(pself, PROC_INFO_CALL_SETCONTROL, flavor, NO_CHECK_SAME_USER))) {",
            "\t\tgoto out;",
            "\t}",
            "",
            "\tswitch (flavor) {",
            "\tcase PROC_SELFSET_PCONTROL: {",
            "\t\tif (pcontrol > P_PCMAX) {",
            "\t\t\treturn EINVAL;",
            "\t\t}",
            "\t\tproc_lock(pself);",
            "\t\t/* reset existing control setting while retaining action state */",
            "\t\tpself->p_pcaction &= PROC_ACTION_MASK;",
            "\t\t/* set new control state */",
            "\t\tpself->p_pcaction |= pcontrol;",
            "\t\tproc_unlock(pself);",
            "\t}",
            "\tbreak;",
            "",
            "\tcase PROC_SELFSET_THREADNAME: {",
            "\t\t/*",
            "\t\t * This is a bit ugly, as it copies the name into the kernel, and then",
            "\t\t * invokes bsd_setthreadname again to copy it into the uthread name",
            "\t\t * buffer.  Hopefully this isn't such a hot codepath that an additional",
            "\t\t * MAXTHREADNAMESIZE copy is a big issue.",
            "\t\t */",
            "\t\tif (buffersize > (MAXTHREADNAMESIZE - 1)) {",
            "\t\t\treturn ENAMETOOLONG;",
            "\t\t}",
            "",
            "\t\tut = current_uthread();",
            "",
            "\t\tbzero(name_buf, MAXTHREADNAMESIZE);",
            "\t\terror = copyin(buffer, name_buf, buffersize);",
            "",
            "\t\tif (!error) {",
            "\t\t\tbsd_setthreadname(ut, thread_tid(current_thread()), name_buf);",
            "\t\t}",
            "\t}",
            "\tbreak;",
            "",
            "\tcase PROC_SELFSET_VMRSRCOWNER: {",
            "\t\t/* need to to be superuser */",
            "\t\tif (suser(kauth_cred_get(), (u_short *)0) != 0) {",
            "\t\t\terror = EPERM;",
            "\t\t\tgoto out;",
            "\t\t}",
            "",
            "\t\tproc_lock(pself);",
            "\t\t/* reset existing control setting while retaining action state */",
            "\t\tpself->p_lflag |= P_LVMRSRCOWNER;",
            "\t\tproc_unlock(pself);",
            "\t}",
            "\tbreak;",
            "",
            "\tcase PROC_SELFSET_DELAYIDLESLEEP: {",
            "#if CONFIG_DELAY_IDLE_SLEEP",
            "\t\t/* mark or clear the process property to delay idle sleep disk IO */",
            "\t\tif (pcontrol != 0) {",
            "\t\t\tOSBitOrAtomic(P_DELAYIDLESLEEP, &pself->p_flag);",
            "\t\t} else {",
            "\t\t\tOSBitAndAtomic(~((uint32_t)P_DELAYIDLESLEEP), &pself->p_flag);",
            "\t\t}",
            "\t}",
            "\tbreak;"
          ]
        }
      ]
    },
