      "excerpts": [
        {
          "start_line": 478,
          "end_line": 529,
          "lines": [
            "/*",
            " * setsid_internal",
            " *",
            " * Description:\tCore implementation of setsid().",
            " */",
            "int",
            "setsid_internal(proc_t p)",
            "{",
            "\tstruct pgrp * pg = PGRP_NULL;",
            "",
            "\tif (p->p_pgrpid == proc_getpid(p) ||",
            "\t    (pg = pgrp_find(proc_getpid(p)))) {",
            "\t\tpgrp_rele(pg);",
            "\t\treturn EPERM;",
            "\t}",
            "",
            "\t/* enter pgrp works with its own pgrp refcount */",
            "\t(void)enterpgrp(p, proc_getpid(p), 1);",
            "\treturn 0;",
            "}",
            "",
            "/*",
            " * setsid",
            " *",
            " * Description:\tCreate a new session and set the process group ID to the",
            " *\t\tsession ID",
            " *",
            " * Parameters:\t(void)",
            " *",
            " * Returns:\t0\t\t\t\tSuccess",
            " *\t\tEPERM\t\t\t\tPermission denied",
            " *",
            " * Notes:\tIf the calling process is not the process group leader; there",
            " *\t\tis no existing process group with its ID, then this function will",
            " *\t\tcreate a new session, a new process group, and put the caller in the",
            " *\t\tprocess group (as the sole member) and make it the session",
            " *\t\tleader (as the sole process in the session).",
            " *",
            " *\t\tThe existing controlling tty (if any) will be dissociated",
            " *\t\tfrom the process, and the next non-O_NOCTTY open of a tty",
            " *\t\twill establish a new controlling tty.",
            " *",
            " * XXX:\t\tBelongs in kern_proc.c",
            " */",
            "int",
            "setsid(proc_t p, __unused struct setsid_args *uap, int32_t *retval)",
            "{",
            "\tint rc = setsid_internal(p);",
            "\tif (rc == 0) {",
            "\t\t*retval = proc_getpid(p);",
            "\t}",
            "\treturn rc;"
          ]
        },
        {
          "start_line": 570,
          "end_line": 638,
          "lines": [
            "int",
            "setpgid(proc_t curp, struct setpgid_args *uap, __unused int32_t *retval)",
            "{",
            "\tproc_t targp = PROC_NULL;       /* target process */",
            "\tstruct pgrp *curp_pg = PGRP_NULL;",
            "\tstruct pgrp *targp_pg = PGRP_NULL;",
            "\tint error = 0;",
            "\tint refheld = 0;",
            "\tint samesess = 0;",
            "",
            "\tcurp_pg = proc_pgrp(curp, NULL);",
            "",
            "\tif (uap->pid != 0 && uap->pid != proc_getpid(curp)) {",
            "\t\tif ((targp = proc_find(uap->pid)) == 0 || !inferior(targp)) {",
            "\t\t\tif (targp != PROC_NULL) {",
            "\t\t\t\trefheld = 1;",
            "\t\t\t}",
            "\t\t\terror = ESRCH;",
            "\t\t\tgoto out;",
            "\t\t}",
            "\t\trefheld = 1;",
            "\t\ttargp_pg = proc_pgrp(targp, NULL);",
            "\t\tif (targp_pg->pg_session != curp_pg->pg_session) {",
            "\t\t\terror = EPERM;",
            "\t\t\tgoto out;",
            "\t\t}",
            "\t\tif (targp->p_flag & P_EXEC) {",
            "\t\t\terror = EACCES;",
            "\t\t\tgoto out;",
            "\t\t}",
            "\t} else {",
            "\t\ttargp = curp;",
            "\t\ttargp_pg = proc_pgrp(targp, NULL);",
            "\t}",
            "",
            "\tif (SESS_LEADER(targp, targp_pg->pg_session)) {",
            "\t\terror = EPERM;",
            "\t\tgoto out;",
            "\t}",
            "",
            "\tif (uap->pgid < 0) {",
            "\t\terror = EINVAL;",
            "\t\tgoto out;",
            "\t}",
            "\tif (uap->pgid == 0) {",
            "\t\tuap->pgid = proc_getpid(targp);",
            "\t} else if (uap->pgid != proc_getpid(targp)) {",
            "\t\tstruct pgrp *pg = PGRP_NULL;",
            "",
            "\t\tif ((pg = pgrp_find(uap->pgid)) == PGRP_NULL) {",
            "\t\t\terror = EPERM;",
            "\t\t\tgoto out;",
            "\t\t}",
            "\t\tsamesess = (pg->pg_session != curp_pg->pg_session);",
            "\t\tpgrp_rele(pg);",
            "\t\tif (samesess != 0) {",
            "\t\t\terror = EPERM;",
            "\t\t\tgoto out;",
            "\t\t}",
            "\t}",
            "\terror = enterpgrp(targp, uap->pgid, 0);",
            "out:",
            "\tpgrp_rele(curp_pg);",
            "\tpgrp_rele(targp_pg);",
            "\tif (refheld != 0) {",
            "\t\tproc_rele(targp);",
            "\t}",
            "\treturn error;",
            "}"
          ]
        }
      ]
    },
    {
      "path": "bsd/kern/kern_proc.c",
      "blob_sha": "62f9712abe40f60a4365342f7a8457a19e5ab6b4",
      "url": "https://github.com/apple-oss-distributions/xnu/blob/d8b80295118ef25ac3a784134bcf95cd8e88109f/bsd/kern/kern_proc.c",
      "excerpts": [
        {
          "start_line": 2504,
          "end_line": 2585,
          "lines": [
            "int",
            "enterpgrp(proc_t p, pid_t pgid, int mksess)",
            "{",
            "\tstruct pgrp *pgrp;",
            "\tstruct pgrp *mypgrp;",
            "\tstruct session *procsp;",
            "",
            "\tpgrp = pgrp_find(pgid);",
            "\tmypgrp = proc_pgrp(p, &procsp);",
            "",
            "#if DIAGNOSTIC",
            "\tif (pgrp != NULL && mksess) {   /* firewalls */",
            "\t\tpanic(\"enterpgrp: setsid into non-empty pgrp\");",
            "\t}",
            "\tif (SESS_LEADER(p, mypgrp->pg_session)) {",
            "\t\tpanic(\"enterpgrp: session leader attempted setpgrp\");",
            "\t}",
            "#endif",
            "\tif (pgrp == PGRP_NULL) {",
            "\t\tstruct session *sess;",
            "\t\tpid_t savepid = proc_getpid(p);",
            "\t\tproc_t np = PROC_NULL;",
            "",
            "\t\t/*",
            "\t\t * new process group",
            "\t\t */",
            "#if DIAGNOSTIC",
            "\t\tif (proc_getpid(p) != pgid) {",
            "\t\t\tpanic(\"enterpgrp: new pgrp and pid != pgid\");",
            "\t\t}",
            "#endif",
            "\t\tif ((np = proc_find(savepid)) == NULL || np != p) {",
            "\t\t\tif (np != PROC_NULL) {",
            "\t\t\t\tproc_rele(np);",
            "\t\t\t}",
            "\t\t\tpgrp_rele(mypgrp);",
            "\t\t\treturn ESRCH;",
            "\t\t}",
            "\t\tproc_rele(np);",
            "",
            "\t\tpgrp = pgrp_alloc(pgid, PGRP_REF_EMPTY);",
            "",
            "\t\tif (mksess) {",
            "\t\t\t/*",
            "\t\t\t * new session",
            "\t\t\t */",
            "\t\t\tsess = session_alloc(p);",
            "",
            "\t\t\tbcopy(mypgrp->pg_session->s_login, sess->s_login,",
            "\t\t\t    sizeof(sess->s_login));",
            "\t\t\tos_atomic_andnot(&p->p_flag, P_CONTROLT, relaxed);",
            "\t\t} else {",
            "\t\t\tsess = session_ref(procsp);",
            "\t\t}",
            "",
            "\t\tproc_list_lock();",
            "\t\tpgrp->pg_session = sess;",
            "\t\tp->p_sessionid = sess->s_sid;",
            "\t\tpghash_insert_locked(pgrp);",
            "\t\tif (mksess) {",
            "\t\t\tLIST_INSERT_HEAD(SESSHASH(sess->s_sid), sess, s_hash);",
            "\t\t}",
            "\t\tproc_list_unlock();",
            "\t} else if (pgrp == mypgrp) {",
            "\t\tpgrp_rele(pgrp);",
            "\t\tpgrp_rele(mypgrp);",
            "\t\treturn 0;",
            "\t}",
            "",
            "\t/*",
            "\t * Adjust eligibility of affected pgrps to participate in job control.",
            "\t * Increment eligibility counts before decrementing, otherwise we",
            "\t * could reach 0 spuriously during the first call.",
            "\t */",
            "\tfixjobc(p, pgrp, 1);",
            "\tfixjobc(p, mypgrp, 0);",
            "",
            "\tpgrp_rele(mypgrp);",
            "\tpgrp_replace(p, pgrp);",
            "",
            "\treturn 0;",
            "}"
          ]
        }
      ]
    },
    {
      "path": "bsd/kern/kern_exec.c",
      "blob_sha": "8bba07814e907b312a684bfb5a884586d5fdcf58",
      "url": "https://github.com/apple-oss-distributions/xnu/blob/d8b80295118ef25ac3a784134bcf95cd8e88109f/bsd/kern/kern_exec.c",
      "excerpts": [
        {
          "start_line": 4303,
          "end_line": 4330,
          "lines": [
            "\tif (!error && imgp->ip_px_sa != NULL) {",
            "\t\tthread_t child_thread = imgp->ip_new_thread;",
            "\t\tuthread_t child_uthread = get_bsdthread_info(child_thread);",
            "",
            "\t\t/*",
            "\t\t * Because of POSIX_SPAWN_SETEXEC, we need to handle this after image",
            "\t\t * activation, else when image activation fails (before the point of no",
            "\t\t * return) would leave the parent process in a modified state.",
            "\t\t */",
            "\t\tif (px_sa.psa_flags & POSIX_SPAWN_SETPGROUP) {",
            "\t\t\tstruct setpgid_args spga;",
            "\t\t\tspga.pid = proc_getpid(p);",
            "\t\t\tspga.pgid = px_sa.psa_pgroup;",
            "\t\t\t/*",
            "\t\t\t * Effectively, call setpgid() system call; works",
            "\t\t\t * because there are no pointer arguments.",
            "\t\t\t */",
            "\t\t\tif ((error = setpgid(p, &spga, ival)) != 0) {",
            "\t\t\t\tgoto bad_px_sa;",
            "\t\t\t}",
            "\t\t}",
            "",
            "\t\tif (px_sa.psa_flags & POSIX_SPAWN_SETSID) {",
            "\t\t\terror = setsid_internal(p);",
            "\t\t\tif (error != 0) {",
            "\t\t\t\tgoto bad_px_sa;",
            "\t\t\t}",
            "\t\t}"
          ]
        }
      ]
    },
