            "int",
            "mac_proc_check_syscall_unix(proc_t curp, int scnum)",
            "{",
            "\tint error;",
            "",
            "#if SECURITY_MAC_CHECK_ENFORCE",
            "\t/* 21167099 - only check if we allow write */",
            "\tif (!mac_proc_enforce) {",
            "\t\treturn 0;",
            "\t}",
            "#endif",
            "\tif (!mac_proc_check_enforce(curp)) {",
            "\t\treturn 0;",
            "\t}",
