{
  "package": "@modelcontextprotocol/server-filesystem",
  "version": "2.2.0",
  "model_kind": null,
  "initialize": {
    "protocolVersion": "2025-11-25",
    "capabilities": {
      "tools": {
        "listChanged": true
      },
      "resources": {
        "listChanged": true
      }
    },
    "serverInfo": {
      "name": "secure-filesystem-server",
      "version": "2.2.0"
    }
  },
  "protocol_version": "2025-11-25",
  "tools": [
    {
      "name": "read_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "tail": {
            "description": "If provided, returns only the last N lines of the file",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "head": {
            "description": "If provided, returns only the first N lines of the file",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "read_text_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "tail": {
            "description": "If provided, returns only the last N lines of the file",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "head": {
            "description": "If provided, returns only the first N lines of the file",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "read_media_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "read_multiple_files",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of file paths to read. Each path must be a string pointing to a valid file within allowed directories."
          }
        },
        "required": [
          "paths"
        ]
      }
    },
    {
      "name": "write_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    {
      "name": "append_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "Text to append, exactly as given. No newline is added: end it with \\n if the next append should start on a new line."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    {
      "name": "edit_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "oldText": {
                  "type": "string",
                  "description": "Text to search for - must match exactly"
                },
                "newText": {
                  "type": "string",
                  "description": "Text to replace with"
                }
              },
              "required": [
                "oldText",
                "newText"
              ]
            }
          },
          "dryRun": {
            "default": false,
            "description": "Preview changes using git-style diff format",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "edits"
        ]
      }
    },
    {
      "name": "create_directory",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "list_directory",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "list_directory_with_sizes",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "sortBy": {
            "default": "name",
            "description": "Sort entries by name or size",
            "type": "string",
            "enum": [
              "name",
              "size"
            ]
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "directory_tree",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "excludePatterns": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depth": {
            "description": "How many levels to descend: 1 lists only the entries directly in path. Directories at the last level have no children array. Omit for the whole tree.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "move_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "destination"
        ]
      }
    },
    {
      "name": "copy_file",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "source": {
            "type": "string",
            "description": "The file to copy"
          },
          "destination": {
            "type": "string",
            "description": "Where to create the copy; nothing may exist there yet"
          }
        },
        "required": [
          "source",
          "destination"
        ]
      }
    },
    {
      "name": "search_files",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "excludePatterns": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "pattern"
        ]
      }
    },
    {
      "name": "get_file_info",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "list_allowed_directories",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    }
  ],
  "read": {
    "content": [
      {
        "type": "text",
        "text": "owned interop"
      }
    ],
    "structuredContent": {
      "content": "owned interop"
    }
  },
  "passed": true
}
