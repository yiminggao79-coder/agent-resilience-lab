+import copy
+import unittest
+
+from boxes import validate as validate_boxes
+from manifest import make, packed
+from packing import pack
+
+CATALOG = [
+    {'sku': 'a', 'weight': 4, 'volume': 1},
+    {'sku': 'b', 'weight': 4, 'volume': 1},
