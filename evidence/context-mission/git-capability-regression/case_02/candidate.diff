+class IncompatibleTests(unittest.TestCase):
+    def test_incompatible_pair_stays_in_separate_cartons(self):
+        result = constrained(
+            CATALOG,
+            [{'sku': 'a', 'quantity': 1},
+             {'sku': 'b', 'quantity': 1},
+             {'sku': 'c', 'quantity': 1}],
+            BIG,
+            {'incompatible': [['a', 'b']]},
+        )
+        self.assertEqual(result['cartons'], [
+            {'box': 'big', 'items': [
+                {'sku': 'a', 'quantity': 1},
+                {'sku': 'c', 'quantity': 1},
