+        if not isinstance(row, dict):
+            raise ValueError('box must be a dictionary')
+        try:
+            code = name(row['code'])
+            max_weight = integer(row['max_weight'])
+            max_volume = integer(row['max_volume'])
+        except KeyError:
+            raise ValueError('missing box field') from None
