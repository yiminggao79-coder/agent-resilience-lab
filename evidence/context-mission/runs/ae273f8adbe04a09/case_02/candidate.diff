+_KEYS = ('tag', 'value', 'unit')
+_ESCAPES = {'\\': '\\', '|': '|', 'n': '\n'}
+
+
+def _encode_field(text):
+    out = []
+    for char in text:
+        if char == '\\':
+            out.append('\\\\')
+        elif char == '|':
+            out.append('\\|')
+        elif char == '\n':
+            out.append('\\n')
+        else:
