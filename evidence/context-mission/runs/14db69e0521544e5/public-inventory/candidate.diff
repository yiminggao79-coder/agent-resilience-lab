+class BuildReportTests(unittest.TestCase):
+    def test_report_fields_and_replay_accounting(self):
+        stock = {'A': 3, 'B': 1, 'zero': 0}
+        orders = [
+            {'id': 'o1', 'items': [{'sku': 'A', 'qty': 2}]},
+            {'id': 'o2', 'items': [{'sku': 'A', 'qty': 2}]},
