+        self.assertEqual(result2['remaining'], {'A': 0})
+        self.assertEqual(result2['results'], [{'id': 'y', 'accepted': True}])
+
+    def test_constructor_stock_not_mutated(self):
+        stock = {'A': 3, 'B': 0}
+        before = copy.deepcopy(stock)
+        inventory = Inventory(stock)
