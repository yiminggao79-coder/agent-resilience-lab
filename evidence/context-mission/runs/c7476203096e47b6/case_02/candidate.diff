+            [{'op': 'delete', 'id': ''}],
+            [{'op': 'delete', 'id': 5}],
+            [{'op': 'delete'}],
+            [{'op': 'upsert'}],
+            [{'op': 'upsert', 'document': {'id': 'x', 'title': 't'}}],
