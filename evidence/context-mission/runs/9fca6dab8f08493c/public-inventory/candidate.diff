+                  {'id': 'o2', 'items': [{'sku': 'B', 'qty': 2}]},
+                  {'id': 'o3', 'items': [{'sku': 'A', 'qty': 1}]}]
+        report = build_report(stock, orders)
+        self.assertEqual(report, {
+            'remaining': {'B': 1, 'A': 2, 'zero': 0},
+            'accepted_unique': 2,
+            'rejected_unique': 1,
+            'units_reserved': 3,
+            'reserved_by_sku': {'A': 3, 'B': 0, 'zero': 0},
+            'rejected_ids': ['o2'],
+        })
+
+    def test_exact_key_set(self):
