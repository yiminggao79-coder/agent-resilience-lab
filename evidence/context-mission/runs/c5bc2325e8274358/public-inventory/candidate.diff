+        replay = inv.allocate([{'id': 'o1', 'items': [{'sku': 'A', 'qty': 3}]}])
+        self.assertEqual(replay['results'], [{'id': 'o1', 'accepted': True}])
+        self.assertEqual(replay['remaining'], {'A': 1})
+
+
+if __name__ == '__main__':
+    unittest.main()
