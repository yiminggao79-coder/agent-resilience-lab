# Configuration reference only: the runtime does NOT automatically load .env.
# Inject a real key locally via a hidden terminal prompt or a secret manager.
# Never put a real key in this tracked file or command-line arguments.
AGENT_LAB_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Optional other-protocol configuration; no compatibility/paid-use certification.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# DeepSeek commands must explicitly select https://api.deepseek.com or
# https://api.deepseek.com/anthropic, with DEEPSEEK_API_KEY and an admitted ledger.
# Existing ledger initialization/reuse and opt-in costs are documented in README.
